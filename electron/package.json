{
    "name": "bigfix-ops-studio",
    "version": "1.0.0",
    "description": "BigFix Ops Studio",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --x64"
    },
    "build": {
        "appId": "com.bigfix.ops.studio",
        "productName": "BigFix Ops Studio",
        "win": {
            "target": "nsis",
            "icon": "bigfix-logo.ico",
            "requestedExecutionLevel": "requireAdministrator"
        },
        "nsis": {
            "installerIcon": "bigfix-logo.ico",
            "uninstallerIcon": "bigfix-logo.ico",
            "installerHeaderIcon": "bigfix-logo.ico",
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "oneClick": false,
            "installerLanguages": [
                "en_US"
            ],
            "include": "installer.nsh"
        },
        "extraResources": [
            {
                "from": "../dist/server.exe",
                "to": "server.exe"
            }
        ]
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0"
    }
}